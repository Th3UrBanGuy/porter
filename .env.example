# ============================================
# Porter v2 - Environment Variables
# ============================================
# Copy this file to .env.local and fill in values

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
CLERK_WEBHOOK_SIGNING_SECRET=whsec_your_secret_here

# Neon Database (from Neon Console → Project Settings → Connection Details)
DATABASE_URL="postgresql://user:pass@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xyz.us-east-2.aws.neon.tech/neondb"

# WebSocket Service (connector communication)
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Cloudflare OAuth (per-user tunnel management)
CF_CLIENT_ID=your_cloudflare_client_id
CF_CLIENT_SECRET=your_cloudflare_client_secret
CF_REDIRECT_URI=http://localhost:3000/api/auth/cloudflare/callback

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
