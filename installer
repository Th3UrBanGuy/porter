    echo "    curl -fsSL https://tinyurl.com/2ctqvyfp | bash"
    echo
    echo "  Windows PowerShell (two-step, most reliable):"
    echo "    curl.exe -fsSL https://tinyurl.com/2ctqvyfp -o install.sh"
    echo "    bash install.sh"
    echo
    echo "  Windows PowerShell (one-line):"
    echo "    curl.exe -fsSL https://tinyurl.com/2ctqvyfp | bash"
    echo
    echo "Supported platforms:"
    echo "  Linux (Debian/Ubuntu, RHEL/Fedora, Arch)"
    echo "  macOS (Homebrew)"
    echo "  Windows (Git Bash, WSL, MSYS2, PowerShell)"
    echo "  Termux (Android)"
    echo
    echo "Environment variables:"
    echo "  PORTER_DIR        Install directory (default: ~/.porter)"
    echo "  PORTER_PORT       Server port (default: 7262)"
    echo "  PORTER_PASSCODE   Custom 6-digit passcode (default: auto-generated)"
    echo "  PORTER_SKIP_START Don't start server after install (default: false)"
    echo
    echo "Examples:"
