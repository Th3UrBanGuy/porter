# ──────────────────────────────────────────────────────────────
#  Main
# ──────────────────────────────────────────────────────────────
main() {
    if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
        usage
        exit 0
    fi

    echo
    printf "${BOLD}Porter Installer v2${RESET}\n"
    printf "%s\n" "Cloudflare Tunnel Portal — Universal Installer"
    echo

    # Init log
    echo "=== Porter install started $(date) ===" > "$LOG_FILE" 2>/dev/null || true

    detect_platform

    # Windows native: separate flow
    if $IS_WINDOWS_NATIVE; then
        install_windows
        return
    fi

    # Check for git
    if command -v git &>/dev/null; then
        HAS_GIT=true
        ok "git available"
    fi

    find_downloader
    ensure_python
    ensure_pip
    detect_pip_flags

    download_files
    install_deps
    verify_deps
    install_cloudflared
    install_cli
    generate_passcode
    create_config
    start_server
    print_summary
}

main "$@"
