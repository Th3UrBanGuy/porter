#!/usr/bin/env bash
# ============================================================================
# Porter — Universal Installer v3
# Downloads Porter, then delegates to setup.sh (Linux/VPS) or handles
# Termux/Windows natively.
#
# Usage:
#   curl -fsSL https://tinyurl.com/2ctqvyfp | bash
# ============================================================================

# Strip CRLF line endings (Windows PowerShell may convert \n to \r\n)
if [ -f "$0" ] && command -v sed &>/dev/null; then
    if grep -q $'\r' "$0" 2>/dev/null; then
        tmpfile=$(mktemp)
        sed 's/\r$//' "$0" > "$tmpfile"
        exec bash "$tmpfile" "$@"
    fi
fi

# ── Configuration ───────────────────────────────────────────
REPO="Th3UrBanGuy/porter"
BRANCH="self-hosted"
RAW_URL="https://raw.githubusercontent.com/${REPO}/${BRANCH}"
INSTALL_DIR="${INSTALL_DIR:-${PORTER_DIR:-$HOME/.porter}}"
PORT=7262
PASSCODE="${PASSCODE:-${PORTER_PASSCODE:-}}"

# ── Colors ──────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[0;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; DIM='\033[2m'; RESET='\033[0m'

ok()   { printf "  ${GREEN}✔${RESET} %s\n" "$1"; }
warn() { printf "  ${YELLOW}⚠${RESET} %s\n" "$1"; }
info() { printf "  ${CYAN}→${RESET} %s\n" "$1"; }
die()  { printf "  ${RED}✘${RESET} %s\n" "$1"; exit 1; }

# ── Platform detection ──────────────────────────────────────
IS_TERMUX=false
IS_WINDOWS_NATIVE=false
PLATFORM="linux"
ARCH="amd64"

detect_platform() {
    local os arch
    os="$(uname -s 2>/dev/null || echo Linux)"
    arch="$(uname -m 2>/dev/null || echo x86_64)"

    case "$os" in
        Linux*)
            if [ -d "/data/data/com.termux" ] || [ -n "${TERMUX_VERSION:-}" ]; then
                PLATFORM="termux"; IS_TERMUX=true
            elif grep -qi microsoft /proc/version 2>/dev/null; then
                PLATFORM="wsl"
            else
                PLATFORM="linux"
            fi
            ;;
        Darwin*)  PLATFORM="macos" ;;
        CYGWIN*|MINGW*|MSYS*|Windows*) PLATFORM="windows"; IS_WINDOWS_NATIVE=true ;;
        *)        PLATFORM="linux" ;;
    esac

    case "$arch" in
        x86_64|amd64)   ARCH="amd64" ;;
        aarch64|arm64)   ARCH="arm64" ;;
        armv7*|armhf)    ARCH="arm" ;;
        *)               ARCH="amd64" ;;
    esac
}

# ── Download helpers ────────────────────────────────────────
DOWNLOADER=""

find_downloader() {
    if command -v curl &>/dev/null; then
        DOWNLOADER="curl"
    elif command -v wget &>/dev/null; then
        DOWNLOADER="wget"
    else
        sudo apt-get install -y -qq curl 2>/dev/null && DOWNLOADER="curl" || true
    fi
    [ -n "$DOWNLOADER" ] || die "curl or wget required"
}

download_file() {
    local url="$1" dest="$2"
    mkdir -p "$(dirname "$dest")"
    local i
    for i in 1 2 3; do
        if [ "$DOWNLOADER" = "curl" ]; then
            curl -fsSL --connect-timeout 15 --max-time 120 "$url" -o "$dest" 2>/dev/null && return 0
        else
            wget -q --timeout=15 "$url" -O "$dest" 2>/dev/null && return 0
        fi
        sleep 1
    done
    return 1
}

# ── Download all files ──────────────────────────────────────
download_files() {
    info "Downloading files..."
    mkdir -p "$INSTALL_DIR"

    local failed=0 f

    for f in app.py cloudflare_client.py tunnel_manager.py api_keys.py requirements.txt setup.py run.sh setup.sh; do
        download_file "${RAW_URL}/${f}" "${INSTALL_DIR}/${f}" || ((failed++))
    done

    mkdir -p "${INSTALL_DIR}/porter"
    for f in __init__.py __main__.py cli.py api.py config.py output.py server.py cloudflare.py platform.py; do
        download_file "${RAW_URL}/porter/${f}" "${INSTALL_DIR}/porter/${f}" || ((failed++))
    done

    mkdir -p "${INSTALL_DIR}/templates"
    for f in setup.html docs.html dashboard.html login.html; do
        download_file "${RAW_URL}/templates/${f}" "${INSTALL_DIR}/templates/${f}" || ((failed++))
    done

    mkdir -p "${INSTALL_DIR}/static"
    for f in icon.svg icon-192.png icon-512.png manifest.json sw.js; do
        download_file "${RAW_URL}/static/${f}" "${INSTALL_DIR}/static/${f}" || ((failed++))
    done

    [ "$failed" -eq 0 ] || die "Download failed ($failed files). Check network."
    ok "Files downloaded"
    chmod +x "${INSTALL_DIR}/setup.sh" "${INSTALL_DIR}/run.sh" 2>/dev/null || true
}

# ── Generate passcode ───────────────────────────────────────
generate_passcode() {
    [ -n "$PASSCODE" ] && return
    PASSCODE=$(head -c 8 /dev/urandom | od -An -tx1 | tr -d ' \n' | head -c 6)
    [ -n "$PASSCODE" ] || PASSCODE=$(echo "$RANDOM$(date +%s%N)" | python3 -c "
import sys, hashlib
h = hashlib.sha256(sys.stdin.read().encode()).hexdigest()
print(''.join([str(int(c, 16) % 10) for c in h[:6]]))
" 2>/dev/null || echo "123456")
}

# ── Create config ───────────────────────────────────────────
create_config() {
    local passcode_hash
    passcode_hash=$(python3 -c "import hashlib; print(hashlib.sha256('${PASSCODE}'.encode()).hexdigest())" 2>/dev/null || echo "")

    mkdir -p "$INSTALL_DIR"
    cat > "${INSTALL_DIR}/config.json" <<EOF
{
  "domain": "",
  "subdomain": "",
  "port": ${PORT},
  "passcode_hash": "${passcode_hash}",
  "tunnel_token": "",
  "account_id": "",
  "tunnel_id": ""
}
EOF
    ok "Config created"
}

# ── Summary ─────────────────────────────────────────────────
print_summary() {
    echo
    printf "${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}\n"
    printf "${BOLD}  Porter installed!${RESET}\n"
    printf "${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}\n"
    echo
    info "Local:   http://localhost:${PORT}"
    info "Setup:   http://localhost:${PORT}/setup"
    info "Passcode: ${PASSCODE}"

    if [ -f "${INSTALL_DIR}/.tunnel_url" ]; then
        local public_url
        public_url=$(cat "${INSTALL_DIR}/.tunnel_url" 2>/dev/null || true)
        [ -n "${public_url:-}" ] && info "Public:  ${public_url}"
    fi
    echo
}

# ── Main ────────────────────────────────────────────────────
main() {
    [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ] && {
        echo "Porter Installer — curl -fsSL https://tinyurl.com/2ctqvyfp | bash"
        echo "Port: always 7262"
        exit 0
    }

    echo
    printf "${BOLD}Porter Installer${RESET}\n"
    echo

    detect_platform
    find_downloader
    download_files
    generate_passcode
    create_config

    # ── Linux / macOS / WSL: delegate to setup.sh ──
    if [ "$PLATFORM" = "linux" ] || [ "$PLATFORM" = "wsl" ] || [ "$PLATFORM" = "macos" ]; then
        export PORT INSTALL_DIR
        bash "${INSTALL_DIR}/setup.sh" || true
        print_summary
        return
    fi

    # ── Termux / Windows: handle natively ──
    local PYTHON=""
    for cmd in python3 python; do
        if command -v "$cmd" &>/dev/null && "$cmd" -c "import sys; assert sys.version_info >= (3, 8)" 2>/dev/null; then
            PYTHON="$cmd"; break
        fi
    done
    [ -n "$PYTHON" ] || die "Python 3.8+ not found"

    cd "${INSTALL_DIR}"
    $PYTHON -m pip install -r requirements.txt --break-system-packages -q 2>/dev/null || \
    $PYTHON -m pip install -r requirements.txt -q 2>/dev/null || true

    $PYTHON -c "import flask, httpx" 2>/dev/null || die "Failed to install dependencies"
    ok "Dependencies installed"

    if ! command -v cloudflared &>/dev/null; then
        local cf_url
        case "$ARCH" in
            arm64) cf_url="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-arm64" ;;
            arm)   cf_url="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-arm" ;;
            *)     cf_url="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64" ;;
        esac
        mkdir -p "$HOME/.local/bin"
        download_file "$cf_url" "$HOME/.local/bin/cloudflared" && \
        chmod +x "$HOME/.local/bin/cloudflared" && \
        export PATH="$HOME/.local/bin:$PATH" && \
        ok "cloudflared installed" || warn "cloudflared install failed"
    fi

    # Start server
    if command -v gunicorn &>/dev/null; then
        nohup gunicorn --bind "0.0.0.0:$PORT" --workers 2 --worker-class gevent --timeout 120 --preload app:app > /dev/null 2>&1 &
    else
        nohup $PYTHON app.py > /dev/null 2>&1 &
    fi
    disown

    # Wait for server to be ready
    local waited=0
    while [ $waited -lt 15 ]; do
        sleep 1; waited=$((waited + 1))
        if curl -sf "http://127.0.0.1:${PORT}/" > /dev/null 2>&1 || \
           curl -sf "http://0.0.0.0:${PORT}/" > /dev/null 2>&1; then
            break
        fi
    done
    ok "Server running on port ${PORT}"

    # Start tunnel
    if command -v cloudflared &>/dev/null; then
        cloudflared tunnel --url "http://localhost:${PORT}" > "${INSTALL_DIR}/.tunnel.log" 2>&1 &
        local tunnel_pid=$!
        echo "$tunnel_pid" > "${INSTALL_DIR}/.tunnel.pid"
        local waited=0 tunnel_url=""
        while [ $waited -lt 15 ]; do
            sleep 1; waited=$((waited + 1))
            tunnel_url=$(grep -oP 'https://[a-zA-Z0-9.-]+\.trycloudflare\.com' "${INSTALL_DIR}/.tunnel.log" 2>/dev/null | head -1)
            [ -n "$tunnel_url" ] && break
        done
        if [ -n "$tunnel_url" ]; then
            echo "$tunnel_url" > "${INSTALL_DIR}/.tunnel_url"
        fi
    fi

    print_summary
}

main "$@"
